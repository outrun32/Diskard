# Diskard Console local configuration. Copy to .env; never commit .env.
DISKARD_HOST=0.0.0.0
DISKARD_PORT=8700
DISKARD_PUBLISHED_PORT=8700
DISKARD_DB_PASSWORD=CHANGE_ME
# External DB mode only (URL-encode its credentials):
# DISKARD_DATABASE_URL=postgresql+psycopg://diskard:CHANGE_ME@postgres:5432/diskard
DISKARD_LOG_LEVEL=INFO
DISKARD_BUILD_SHA=unknown
DISKARD_PROFILE_FILE=/config/targets.yaml
DISKARD_EVENT_MAX_BYTES=262144
DISKARD_EXPORT_MAX_BYTES=52428800
DISKARD_ALLOWED_ORIGINS=http://localhost:8700,http://127.0.0.1:8700
DISKARD_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

GISKARD_TELEMETRY_DISABLED=true
GISKARD_QUIET=true

# Target profile references. Values are read at execution time and are never
# written to the Diskard database or reports.
DISKARD_ATTACKER_TARGET_KEY=
DISKARD_TRIGGER_TARGET_KEY=
DISKARD_SUBJECT_TARGET_KEY=
DISKARD_SUBJECT_TARGET_TOKEN=
DISKARD_CONTROL_TARGET_KEY=
DISKARD_TARGET_MONGO_URI=

# The bundled local investment profile is zero-config: it bootstraps the standard
# Keycloak test users during validation. Set the references below only for a custom
# target profile.

# Optional separate attacker provider. It is not the target's model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ATTACKER_MODEL=DeepSeek-V4-Flash # optional model identifier
AZURE_OPENAI_API_KEY= # optional adaptive attacker provider
AZURE_OPENAI_ENDPOINT= # optional Azure AI Foundry endpoint
AZURE_OPENAI_API_VERSION=2024-05-01-preview
RESEARCH_MODEL=DeepSeek-V4-Flash
ATTACKER_TIMEOUT_SECONDS=240
